{
  "version": 2,
  "builds": [
    {
      "src": "server/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "40mb",
        "runtime": "python3.9"
      }
    },
    {
      "src": "uploader.html",
      "use": "@vercel/static"
    },
    {
      "src": "static/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/",
      "dest": "/uploader.html"
    },
    {
      "src": "/(.*)",
      "dest": "server/wsgi.py"
    }
  ]
}
